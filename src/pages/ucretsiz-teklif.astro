---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { steps } from '../data/content';
import { SITE } from '../config/site';
---
<Base title="Ücretsiz Dil Okulu Teklifi Alın" description="İngiltere’de dil okulu için ücretsiz, karşılaştırmalı fiyat teklifi: 2–3 okulun kurs, konaklama ve ek ücretleri toplam maliyetle birlikte aynı gün size iletilir.">
  <section class="section" style="background:linear-gradient(180deg,var(--teal-50),var(--paper))">
    <div class="wrap layout-aside">
      <div>
        <span class="eyebrow">Ücretsiz teklif</span>
        <h1>Size özel karşılaştırmalı teklif</h1>
        <p class="lead">Formu doldurun; hedefinize, tarihlerinize ve bütçenize uygun 2–3 okulun güncel fiyatlarını konaklama ve ek ücretlerle birlikte toplam maliyet olarak aynı gün iletelim.</p>
        <ul class="checks" style="margin:1.5rem 0">
          <li>Danışmanlık tamamen ücretsiz, okulun resmi fiyatı</li>
          <li>Okulların güncel kampanya ve erken kayıt indirimleri</li>
          <li>Vize dosyası, konaklama ve havalimanı karşılama tek elden</li>
          <li>{SITE.stats.years} yıllık deneyim, {SITE.stats.students} öğrenci</li>
        </ul>
        <ol class="mini">{steps.slice(0, 4).map((s, i) => <li><span>{i + 1}</span><b>{s.t}</b></li>)}</ol>
        <p class="small muted" style="margin-top:1.5rem"><Icon name="phone" size={14} /> Hemen konuşmak isterseniz: <a href={`tel:${SITE.phone}`} data-track="quote-page">{SITE.phoneDisplay}</a></p>
      </div>
      <aside><LeadForm source="teklif-sayfasi" /></aside>
    </div>
  </section>
</Base>
<style>
  .mini { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .mini li { display: flex; gap: 0.75rem; align-items: center; }
  .mini span { width: 28px; height: 28px; border-radius: 50%; background: var(--teal-900); color: #fff; display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; flex: none; }
</style>
