---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photos from '../components/Photos.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { testimonials } from '../data/content';
import { SITE } from '../config/site';
---
<Base title="Öğrenci Yorumları: İngiltere’de Dil Okuluna Gidenler Anlatıyor" description="İngiltere’de dil okuluna giden öğrencilerimizin ve velilerin yorumları, Londra’dan sertifika ve mezuniyet kareleri.">
  <section class="phero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Öğrenci yorumları' }]} />
      <span class="eyebrow">Gidenler anlatıyor</span>
      <h1>Öğrenci yorumları</h1>
      <p class="lead">{SITE.stats.students} öğrenciye yurt dışı eğitim danışmanlığı verdik. Okul seçiminden dönüşe kadar süreci yaşayan öğrencilerimiz ve velilerimiz anlatıyor.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="shead"><span class="eyebrow">Kareler</span><h2>Öğrencilerimizden kareler</h2></div>
      <Photos />
    </div>
  </section>
  <section class="section section--mist">
    <div class="wrap">
      <div class="shead"><span class="eyebrow">Yorumlar</span><h2>Öğrenci ve veli yorumları</h2></div>
      <div class="grid grid--3">
        {testimonials.map((t) => (
          <figure class="card" style="margin:0;display:flex;flex-direction:column;gap:.75rem">
            <div style="display:flex;gap:2px;color:var(--gold)">{[1,2,3,4,5].map(() => <Icon name="star" size={16} />)}</div>
            <blockquote style="margin:0;color:var(--ink-2)">“{t.text}”</blockquote>
            <figcaption style="margin-top:auto;font-size:.88rem"><b>{t.name}</b><br /><span class="muted">{t.program} · {t.source}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="note note--teal" style="margin-top:2rem">
        <strong>Siz de deneyiminizi paylaşın.</strong> İngiltere’den döndüyseniz fotoğraflarınızı ve yorumunuzu <a href={`mailto:${SITE.email}?subject=Öğrenci yorumu`}>{SITE.email}</a> adresine veya WhatsApp’tan gönderebilirsiniz.
      </div>
    </div>
  </section>
  <CtaBand title="Sıradaki başarı hikâyesi sizin olsun" />
</Base>
