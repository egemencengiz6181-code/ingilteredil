---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

const airports = [
  { code: 'LHR', name: 'Londra Heathrow', serves: 'Londra, Oxford, Windsor', price: '£95–160', time: 'Londra merkez 60–90 dk' },
  { code: 'LGW', name: 'Londra Gatwick', serves: 'Brighton, Eastbourne, Güney Londra', price: '£90–170', time: 'Brighton 40 dk' },
  { code: 'STN', name: 'Londra Stansted', serves: 'Cambridge, Doğu Londra', price: '£85–170', time: 'Cambridge 40 dk' },
  { code: 'MAN', name: 'Manchester', serves: 'Manchester, Liverpool, Leeds', price: '£50–110', time: 'Manchester merkez 25 dk' },
  { code: 'BHX', name: 'Birmingham', serves: 'Birmingham', price: '£50–80', time: 'Merkez 20 dk' },
  { code: 'BRS', name: 'Bristol', serves: 'Bristol, Bath', price: '£50–95', time: 'Bath 45 dk' },
  { code: 'EDI', name: 'Edinburgh', serves: 'Edinburgh', price: '£50–75', time: 'Merkez 30 dk' },
];
const faqs = [
  { q: 'Uçağım rötar yaparsa ne olur?', a: 'Uçuş numaranızı önceden aldığımız için şoför uçuşunuzu canlı takip eder; rötarlarda ek ücret ödemeden sizi bekler. İniş sonrası genellikle 60 dakika ücretsiz bekleme süresi vardır.' },
  { q: 'Karşılama ücreti ne kadar?', a: 'Ücret havalimanı ve gideceğiniz adrese göre değişir; Heathrow’dan Londra’ya tek yön yaklaşık £95–160’tır. Her şey dahil Londra paketinde VIP karşılama fiyata dahildir.' },
  { q: 'Şoförü nasıl bulacağım?', a: 'Gümrükten çıktıktan sonra varış salonunda isminizin yazılı olduğu tabelayla bekleyen şoförünüz sizi karşılar. Şoförün adı ve telefon numarası uçuştan önce WhatsApp’tan iletilir.' },
  { q: 'Gece geç saatte iniyorum, aile beni kabul eder mi?', a: 'Evet, okul ve aile varış saatinizden önceden haberdar edilir. Gece yarısından sonraki varışlarda bazı okullar ek ücret talep edebilir; bunu teklif aşamasında belirtiriz.' },
  { q: 'Toplu taşımayla gitmek daha ucuz değil mi?', a: 'Heathrow’dan Elizabeth line veya Piccadilly hattıyla Londra’ya gitmek ucuzdur (£6–13), ancak ilk gelişte valizlerle aktarma yapmak ve adres bulmak yorucu olabilir. Özellikle ilk kez gidenlere ve gece varışlarında karşılama hizmetini öneriyoruz.' },
];
---
<Base
  title="İngiltere Havalimanı Karşılama ve Transfer: Heathrow, Gatwick, Manchester"
  description="Dil okulu öğrencileri için İngiltere havalimanı karşılama: Heathrow, Gatwick, Stansted, Manchester ve diğer havalimanlarında isminizle karşılama ve konaklama adresinize özel transfer."
  waMessage="Merhaba, İngiltere’de havalimanı karşılama hizmeti hakkında bilgi almak istiyorum."
>
  <section class="phero phero--split">
    <div class="wrap">
      <div>
        <Breadcrumbs items={[{ label: 'Havalimanı karşılama' }]} />
        <span class="pass">IST <i></i> LHR</span>
        <h1>Havalimanı karşılama ve transfer</h1>
        <p class="lead">İngiltere’ye ilk adımınızda yalnız değilsiniz. Varış salonunda isminizin yazılı olduğu tabelayla karşılanır, doğrudan aile yanı veya yurt adresinize götürülürsünüz. Ailenize de “vardı” mesajını biz iletiriz.</p>
        <ul class="checks" style="margin-top:1.25rem">
          <li>Uçuş takibi: rötarda ek ücretsiz bekleme</li>
          <li>Şoför bilgisi uçuştan önce WhatsApp’ta</li>
          <li>Konaklamanıza kapıdan kapıya transfer</li>
          <li>Varışta aileyle ve okulla koordinasyon</li>
          <li>İngiltere SIM kartı ve Oyster kart bilgilendirmesi</li>
        </ul>
      </div>
      <LeadForm source="havalimani" title="Karşılama teklifi alın" subtitle="Uçuş tarihinizi, havalimanınızı ve konaklama adresinizi paylaşın; size transfer seçeneklerini iletelim." />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="shead"><span class="eyebrow">Havalimanları</span><h2>Hangi havalimanı, hangi şehir?</h2><p class="lead">Türkiye’den İngiltere’ye en sık kullanılan havalimanları ve özel transfer için yaklaşık tek yön ücret aralıkları.</p></div>
      <div class="grid grid--3">
        {airports.map((a) => (
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center"><span class="pass" style="font-size:1.1rem">IST <i></i> {a.code}</span><Icon name="plane" size={20} /></div>
            <h3 style="margin-top:.8rem">{a.name}</h3>
            <p class="small muted mb-0">{a.serves}</p>
            <dl class="ap"><div><dt>Özel transfer</dt><dd>{a.price}</dd></div><div><dt>Süre</dt><dd>{a.time}</dd></div></dl>
          </div>
        ))}
      </div>
      <p class="xs muted" style="margin-top:.75rem">Fiyatlar okulların ve transfer partnerlerinin tek yön ücretlerine dayanır; tarih, saat ve adrese göre değişir.</p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap wrap--narrow">
      <div class="shead shead--center"><span class="eyebrow">Sık sorulanlar</span><h2>Karşılama hakkında sorular</h2></div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .ap { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.9rem 0 0; padding-top: 0.8rem; border-top: 1px dashed var(--line); }
  .ap dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .ap dd { margin: 0; font-weight: 650; color: var(--teal-950); font-size: 0.92rem; }
</style>
