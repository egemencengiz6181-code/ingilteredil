---
import { studentPhotos } from '../data/content';
---
<div class="ph">
  {studentPhotos.map((p) => (
    <figure>
      <img src={p.src} alt={`${p.caption}: ${p.place}`} width={p.w} height={p.h} loading="lazy" decoding="async" />
      <figcaption><b>{p.caption}</b><span>{p.place}</span></figcaption>
    </figure>
  ))}
</div>
<style>
  .ph { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  @media (min-width: 820px) { .ph { grid-template-columns: repeat(4, 1fr); } }
  .ph figure { margin: 0; position: relative; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 3/4; background: var(--teal-100); }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .ph figcaption { position: absolute; inset: auto 0 0 0; padding: 2rem 0.9rem 0.8rem; background: linear-gradient(transparent, #062830d9); color: #fff; display: grid; font-size: 0.85rem; }
  .ph figcaption span { color: #cfe6eb; font-size: 0.78rem; }
</style>
