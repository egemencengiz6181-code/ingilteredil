---
import Icon from './Icon.astro';
import type { City } from '../data/types';
import { cityPath, schoolsInCity, cityMinPrice, gbp } from '../data';
interface Props { city: City }
const { city: c } = Astro.props;
const n = schoolsInCity(c.slug).length;
const from = cityMinPrice(c.slug);
const budget = ['', 'Uygun', 'Orta', 'Yüksek'][c.budgetLevel];
---
<article class="card card--hover cc">
  <div class="cc__pass">
    <span>IST</span><i></i><span class="cc__code">{c.code}</span>
  </div>
  <h3><a href={cityPath(c)} class="stretched">{c.name} dil okulları</a></h3>
  <p class="cc__tag">{c.tagline}</p>
  <div class="tags">{c.vibe.slice(0, 3).map((v) => <span class="tag">{v}</span>)}</div>
  <dl class="cc__meta">
    <div><dt>Okul</dt><dd>{n > 0 ? n : '—'}</dd></div>
    <div><dt>Kurs</dt><dd>{from ? `${gbp(from)}/hf’dan` : 'Teklif alın'}</dd></div>
    <div><dt>Bütçe</dt><dd>{budget}</dd></div>
  </dl>
  <span class="cc__more">Şehir rehberi ve fiyatlar <Icon name="arrow" size={16} /></span>
</article>
<style>
  .cc { display: flex; flex-direction: column; gap: 0.6rem; }
  .cc__pass { display: flex; align-items: center; gap: 0.6rem; font-family: var(--f-mono); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; color: var(--ink-3); }
  .cc__pass i { flex: 1; height: 1px; background: repeating-linear-gradient(90deg, var(--teal-200) 0 5px, transparent 5px 10px); }
  .cc__code { color: #fff; background: var(--teal-900); padding: 0.2rem 0.45rem; border-radius: 6px; }
  .cc h3 { margin: 0.2rem 0 0; font-size: 1.25rem; }
  .cc h3 a { color: var(--teal-950); text-decoration: none; }
  .cc__tag { color: var(--ink-2); font-size: 0.92rem; margin: 0; }
  .cc__meta { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 0.5rem; margin: 0.4rem 0 0; padding-top: 0.75rem; border-top: 1px dashed var(--line); }
  .cc__meta dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .cc__meta dd { margin: 0; font-weight: 650; color: var(--teal-950); font-size: 0.92rem; }
  .cc__more { margin-top: auto; padding-top: 0.2rem; display: inline-flex; gap: 0.3rem; align-items: center; font-weight: 600; color: var(--coral); font-size: 0.9rem; }
</style>
