---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
    <rect x="1" y="3" width="38" height="29" rx="9" fill="#0c3a46" />
    <path d="M10 32l-2 7 9-7z" fill="#0c3a46" />
    <text x="20" y="23.5" text-anchor="middle" font-family="Bricolage Grotesque Variable, system-ui, sans-serif" font-size="14" font-weight="800" fill="#fff" letter-spacing="0.5">EN</text>
    <circle cx="33" cy="8" r="4.5" fill="#d93a42" stroke="#fff" stroke-width="1.5" />
  </svg>
  <span class="logo__text"><b>İngiltere’de</b><span>Dil Eğitimi</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo__mark { flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; font-family: var(--f-display); letter-spacing: -0.02em; }
  .logo__text b { font-size: 1.12rem; font-weight: 750; color: var(--teal-950); }
  .logo__text span { font-size: 0.98rem; font-weight: 600; color: var(--coral); margin-top: 2px; }
  .logo--light .logo__text b { color: #fff; }
</style>
