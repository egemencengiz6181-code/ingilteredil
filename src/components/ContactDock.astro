---
import Icon from './Icon.astro';
import { SITE, waLink } from '../config/site';

interface Props { message?: string }
const { message = 'Merhaba, İngiltere’de dil okulu hakkında bilgi almak istiyorum.' } = Astro.props;
const wa = waLink(message);
---
<!-- Masaüstü: yüzen WhatsApp butonu -->
<a href={wa} class="wa-float hide-sm" target="_blank" rel="noopener" data-track="float" aria-label="WhatsApp’tan yazın">
  <Icon name="whatsapp" size={30} />
  <span class="wa-float__tip">Sorunuz mu var? <b>WhatsApp’tan yazın</b></span>
</a>

<!-- Mobil: alt sabit iletişim çubuğu -->
<nav class="dock show-sm" aria-label="Hızlı iletişim">
  <a href={`tel:${SITE.phone}`} data-track="dock"><Icon name="phone" size={20} /> Ara</a>
  <a href={wa} target="_blank" rel="noopener" class="dock__wa" data-track="dock"><Icon name="whatsapp" size={20} /> WhatsApp</a>
  <a href="/ucretsiz-teklif/" class="dock__cta">Teklif Al</a>
</nav>

<style>
  .wa-float { position: fixed; right: 22px; bottom: 22px; z-index: 40; width: 60px; height: 60px; border-radius: 50%; background: var(--wa); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 30px -8px #1fa85599; transition: transform 0.2s var(--ease); }
  .wa-float:hover { transform: scale(1.06); color: #fff; }
  .wa-float__tip { position: absolute; right: 72px; white-space: nowrap; background: var(--paper); color: var(--ink-2); border: 1px solid var(--line); border-radius: var(--r-md); padding: 0.5rem 0.8rem; font-size: 0.85rem; box-shadow: var(--shadow-1); opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .wa-float:hover .wa-float__tip { opacity: 1; }
  .wa-float__tip b { color: var(--teal-900); }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1.2fr 1.2fr; background: var(--paper); border-top: 1px solid var(--line); box-shadow: 0 -6px 20px -10px #0c3a4633; padding-bottom: env(safe-area-inset-bottom); }
  .dock a { display: flex; align-items: center; justify-content: center; gap: 0.4rem; height: 60px; text-decoration: none; font-weight: 650; color: var(--teal-900); font-size: 0.95rem; }
  .dock__wa { background: var(--wa); color: #fff !important; }
  .dock__cta { background: var(--coral); color: #fff !important; }
</style>
